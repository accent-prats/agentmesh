# ── Platform secrets (required) ────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# ── Database ────────────────────────────────────────────────────────────────────
DB_USER=portal
DB_PASS=portal
DB_NAME=portal

# ── Seeded first admin account (Portal creates this on first startup) ─────────
PORTAL_ADMIN_EMAIL=admin@example.com
PORTAL_ADMIN_PASSWORD=ChangeMe123!

# ── Public URLs (used by nginx virtual hosts) ──────────────────────────────────
PORTAL_PUBLIC_URL=https://portal.local
CULPRIT_PUBLIC_URL=/culprit/

# ── Culprit — Azure Update Manager patch-failure RCA agent ────────────────────
# CULPRIT_RCA_MODEL/ANTHROPIC_API_KEY below are only the fallback path - see
# "AI provider (fallback only)" above.
CULPRIT_RCA_MODEL=claude-opus-5
# Encrypts the Azure/Datadog secrets saved on Culprit's /settings screen at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CULPRIT_ENCRYPTION_KEY=
# Gates every Culprit route behind a shared token. Leave unset for a zero-config
# demo (fails open — loudly logged at startup); set a real value before this
# ever holds real credentials. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
CULPRIT_API_TOKEN=

# ── AI provider (fallback only) ────────────────────────────────────────────────
# Which LLM the deep RCA agent uses is normally configured platform-wide from
# the AgentMesh Portal's Admin → AI Providers screen after first login (any
# provider in shared/src/llm/catalog.py: Anthropic, OpenAI, Azure OpenAI,
# Gemini, Grok, Qwen, DeepSeek, Ollama, LM Studio) - nothing here is required
# for that. ANTHROPIC_API_KEY below is only the fallback Culprit uses if that
# screen is never touched (or its own deployment predates it) - see "AI
# Providers" in docs/SETUP.md.
ANTHROPIC_API_KEY=
# Encrypts AI provider secrets saved on the Portal's AI Providers screen at
# rest. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PORTAL_ENCRYPTION_KEY=

# ── GrowthBook — feature flagging & A/B experimentation ───────────────────────
# GROWTHBOOK_CLIENT_KEY  : SDK key from GrowthBook Admin UI → SDK Connections.
#   1. Start the stack: docker compose up -d growthbook
#   2. Open https://growthbook.local and create an admin account
#   3. Go to SDK Connections → Add Connection → copy the sdk-xxx key here
# GROWTHBOOK_API_HOST    : Internal URL of the GrowthBook SDK API (backend SDK use)
# GROWTHBOOK_URL         : Public URL of the GrowthBook Admin UI (nginx proxy)
GROWTHBOOK_CLIENT_KEY=sdk-
GROWTHBOOK_API_HOST=http://growthbook:3100
GROWTHBOOK_URL=https://growthbook.local
# Required — GrowthBook uses this to encrypt sensitive data in MongoDB.
# Generate with: openssl rand -base64 32
GROWTHBOOK_ENCRYPTION_KEY=

# ── Log level (debug | info | warning | error) ─────────────────────────────────
LOG_LEVEL=info
