<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}Culprit{% endblock %} | AgentMesh</title>
<script src="{{ nav_prefix|default('') }}static/tailwind.js"></script>
<script>
  tailwind.config = {
    theme: {
      extend: {
        colors: {
          brand: { DEFAULT: '#E11D48', dark: '#9F1239', light: '#FB7185' },
          navy: '#1C0A0F',
        },
      },
    },
  }
</script>
<script src="{{ nav_prefix|default('') }}static/lucide.min.js"></script>
<style>
  body { font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  ::-webkit-scrollbar { width: 8px; height: 8px; }
  ::-webkit-scrollbar-thumb { background: #d1d5db; border-radius: 4px; }
</style>
{% block head %}{% endblock %}
</head>
<body class="bg-gray-50 text-gray-900 antialiased">
<div class="flex h-screen overflow-hidden">

  <!-- Sidebar - same shell every app in this platform uses, Culprit's own rose accent in place of each app's own brand color -->
  <aside class="w-56 shrink-0 bg-navy flex flex-col">
    <div class="px-4 py-5 border-b border-white/10">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-lg bg-brand/20 flex items-center justify-center shrink-0">
          <i data-lucide="search-x" class="w-4 h-4 text-brand-light"></i>
        </div>
        <div class="min-w-0">
          <p class="font-bold text-white text-sm tracking-wide">Culprit</p>
          <p class="text-[10px] text-gray-400 leading-tight truncate">Patch Failure RCA Agent</p>
        </div>
      </div>
    </div>

    <nav class="flex-1 px-3 py-4 space-y-1">
      <a href="{{ nav_prefix|default('') }}."
         class="flex items-center gap-2.5 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors {{ 'bg-brand/15 text-brand-light' if active == 'console' else 'text-gray-400 hover:text-white hover:bg-white/10' }}">
        <i data-lucide="layout-dashboard" class="w-[15px] h-[15px]"></i> Console
      </a>
      <a href="{{ nav_prefix|default('') }}runs.html"
         class="flex items-center gap-2.5 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors {{ 'bg-brand/15 text-brand-light' if active == 'runs' else 'text-gray-400 hover:text-white hover:bg-white/10' }}">
        <i data-lucide="list-checks" class="w-[15px] h-[15px]"></i> Runs
      </a>
      <a href="{{ nav_prefix|default('') }}settings"
         class="flex items-center gap-2.5 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors {{ 'bg-brand/15 text-brand-light' if active == 'settings' else 'text-gray-400 hover:text-white hover:bg-white/10' }}">
        <i data-lucide="settings" class="w-[15px] h-[15px]"></i> Settings
      </a>
      <a href="{{ nav_prefix|default('') }}precision.html"
         class="flex items-center gap-2.5 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors {{ 'bg-brand/15 text-brand-light' if active == 'precision' else 'text-gray-400 hover:text-white hover:bg-white/10' }}">
        <i data-lucide="gauge" class="w-[15px] h-[15px]"></i> Precision gate
      </a>
      {% if remediation_enabled %}
      <a href="{{ nav_prefix|default('') }}remediation/log.html"
         class="flex items-center gap-2.5 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors {{ 'bg-brand/15 text-brand-light' if active == 'remediation' else 'text-gray-400 hover:text-white hover:bg-white/10' }}">
        <i data-lucide="wrench" class="w-[15px] h-[15px]"></i> Remediation log
      </a>
      {% endif %}
      <a href="{{ nav_prefix|default('') }}docs" target="_blank" rel="noopener"
         class="flex items-center gap-2.5 px-3 py-2.5 rounded-lg text-sm font-medium text-gray-400 hover:text-white hover:bg-white/10 transition-colors">
        <i data-lucide="code" class="w-[15px] h-[15px]"></i> API reference
      </a>
    </nav>

    <div class="px-4 py-4 border-t border-white/10 space-y-3">
      <a href="{{ portal_url }}" class="flex items-center gap-2 text-xs text-gray-400 hover:text-white transition-colors" title="Back to AgentMesh Portal">
        <i data-lucide="arrow-left" class="w-3 h-3"></i> Portal Home
      </a>
      <a href="{{ nav_prefix|default('') }}logout" class="flex items-center gap-2 text-xs text-gray-400 hover:text-white transition-colors" title="Sign out of Culprit">
        <i data-lucide="log-out" class="w-3 h-3"></i> Sign out
      </a>
      <p class="text-[10px] text-gray-500 leading-relaxed">
        AgentMesh &middot; Enterprise Agentic Platform<br>
        Autonomous Patch RCA &middot; Read-only mode
      </p>
    </div>
  </aside>

  <!-- Main -->
  <main class="flex-1 overflow-y-auto">
    {% block content %}{% endblock %}
  </main>
</div>

<script>
  lucide.createIcons();

  // Shared by every "_evidence_gap.html.j2" card (Fleet Report's Missing
  // evidence section, the machine drill-down page's Incomplete evidence
  // section) - lives here, not in either page's own script block, so the
  // two templates that both import that macro don't duplicate the same
  // handful of lines and drift apart.
  document.querySelectorAll('.eg-detail-toggle').forEach(function (btn) {
    btn.addEventListener('click', function () {
      const panel = btn.nextElementSibling;
      const chevron = btn.querySelector('.eg-detail-chevron');
      const nowHidden = panel.classList.toggle('hidden');
      chevron.style.transform = nowHidden ? '' : 'rotate(90deg)';
    });
  });
  document.querySelectorAll('.eg-copy-btn').forEach(function (btn) {
    btn.addEventListener('click', async function () {
      const label = btn.querySelector('.eg-copy-label');
      const original = label.textContent;
      try {
        await navigator.clipboard.writeText(btn.dataset.copy);
        label.textContent = 'Copied!';
      } catch (err) {
        label.textContent = 'Copy failed';
      }
      setTimeout(function () { label.textContent = original; }, 1500);
    });
  });
</script>
{% block scripts %}{% endblock %}
</body>
</html>
