{% macro evidence_gap_card(gap) %}
<div class="rounded-lg border border-gray-200 overflow-hidden">
  <div class="flex items-center gap-2 px-3 py-2 bg-gray-50 border-b border-gray-100">
    <i data-lucide="{{ gap.icon }}" class="w-3.5 h-3.5 text-gray-400 shrink-0"></i>
    <span class="text-[10.5px] font-semibold uppercase tracking-wide text-gray-500">{{ gap.label }}</span>
    {% if gap.correlation_id %}
    <button type="button" class="eg-copy-btn ml-auto inline-flex items-center gap-1 text-[10.5px] font-mono text-gray-400 hover:text-brand"
      data-copy="{{ gap.correlation_id }}" title="Copy correlation ID for an Azure support ticket">
      <i data-lucide="copy" class="eg-copy-icon w-3 h-3"></i> <span class="eg-copy-label">{{ gap.correlation_id[:8] }}{% if gap.correlation_id|length > 8 %}&hellip;{% endif %}</span>
    </button>
    {% endif %}
  </div>
  <div class="px-3 py-2">
    <p class="text-xs text-gray-600">{{ gap.summary }}</p>
    {% if gap.detail %}
    <button type="button" class="eg-detail-toggle mt-1 text-[11px] text-brand hover:text-brand-dark inline-flex items-center gap-1">
      <i data-lucide="chevron-right" class="eg-detail-chevron w-3 h-3 transition-transform"></i> Show full error
    </button>
    <pre class="eg-detail-panel hidden mt-1.5 text-[11px] font-mono text-gray-500 whitespace-pre-wrap bg-gray-50 border border-gray-100 rounded p-2 max-h-48 overflow-y-auto">{{ gap.detail }}</pre>
    {% endif %}
  </div>
</div>
{% endmacro %}

{% macro azure_error_card(detail) %}
<div class="rounded-lg border border-gray-200 overflow-hidden">
  <div class="flex items-center gap-2 px-3 py-2 bg-gray-50 border-b border-gray-100">
    <i data-lucide="x-circle" class="w-3.5 h-3.5 text-red-600 shrink-0"></i>
    <span class="text-[11px] font-medium text-gray-700">Azure-reported install error</span>
    {% if detail.code %}
    <span class="ml-auto text-[10px] font-semibold uppercase tracking-wide px-2 py-0.5 rounded-full border bg-red-50 text-red-600 border-red-200">{{ detail.code }}</span>
    {% endif %}
  </div>
  <div class="px-3 py-2">
    <p class="text-xs text-gray-600">{{ detail.message }}</p>
    {% if detail.target %}
    <p class="text-[11px] text-gray-400 mt-1">target: {{ detail.target }}</p>
    {% endif %}
  </div>
</div>
{% endmacro %}

{% macro log_usage_row(entry) %}
<li class="flex items-start gap-2 py-1.5 border-b border-gray-50 last:border-0">
  <i data-lucide="{{ entry.icon }}" class="w-3.5 h-3.5 shrink-0 mt-0.5
    {%- if entry.badge_color == 'emerald' %} text-emerald-500
    {%- elif entry.badge_color == 'amber' %} text-amber-500
    {%- else %} text-gray-400{% endif %}"></i>
  <div class="min-w-0 flex-1">
    <div class="flex flex-wrap items-center gap-1.5">
      <span class="text-xs text-gray-700 font-medium">{{ entry.label }}</span>
      <span class="text-[9px] font-semibold uppercase tracking-wide px-1.5 py-0.5 rounded-full border
        {%- if entry.badge_color == 'emerald' %} bg-emerald-50 text-emerald-700 border-emerald-200
        {%- elif entry.badge_color == 'amber' %} bg-amber-50 text-amber-700 border-amber-200
        {%- else %} bg-gray-50 text-gray-500 border-gray-200{% endif %}">{{ entry.status_label }}</span>
    </div>
    <p class="text-[11px] text-gray-400 mt-0.5">{{ entry.reason }}</p>
  </div>
</li>
{% endmacro %}

{% macro extension_finding_card(finding) %}
<div class="rounded-lg border border-gray-200 overflow-hidden">
  <div class="flex items-center gap-2 px-3 py-2 bg-gray-50 border-b border-gray-100">
    <i data-lucide="{{ finding.icon }}" class="w-3.5 h-3.5 shrink-0
      {%- if finding.badge_color == 'emerald' %} text-emerald-600
      {%- elif finding.badge_color == 'red' %} text-red-600
      {%- elif finding.badge_color == 'amber' %} text-amber-600
      {%- elif finding.badge_color == 'sky' %} text-sky-600
      {%- else %} text-gray-400{% endif %}"></i>
    <span class="text-[11px] font-medium text-gray-700">
      {{ finding.extension_name }}{% if finding.extension_version %} <span class="text-gray-400">v{{ finding.extension_version }}</span>{% endif %}
      {%- if finding.substatus_name %} &middot; {{ finding.substatus_name }}{% endif %}
    </span>
    <span class="ml-auto text-[10px] font-semibold uppercase tracking-wide px-2 py-0.5 rounded-full border
      {%- if finding.badge_color == 'emerald' %} bg-emerald-50 text-emerald-700 border-emerald-200
      {%- elif finding.badge_color == 'red' %} bg-red-50 text-red-600 border-red-200
      {%- elif finding.badge_color == 'amber' %} bg-amber-50 text-amber-700 border-amber-200
      {%- elif finding.badge_color == 'sky' %} bg-sky-50 text-sky-700 border-sky-200
      {%- else %} bg-gray-50 text-gray-600 border-gray-200{% endif %}">{{ finding.status_label }}</span>
  </div>
  <div class="px-3 py-2">
    <p class="text-xs text-gray-600">{{ finding.message }}{% if finding.code is not none %} <span class="text-gray-400">(code {{ finding.code }})</span>{% endif %}</p>
    {% if finding.raw_status_json %}
    <button type="button" class="eg-detail-toggle mt-1 text-[11px] text-brand hover:text-brand-dark inline-flex items-center gap-1">
      <i data-lucide="chevron-right" class="eg-detail-chevron w-3 h-3 transition-transform"></i> Show full status JSON
    </button>
    <pre class="eg-detail-panel hidden mt-1.5 text-[11px] font-mono text-gray-500 whitespace-pre-wrap bg-gray-50 border border-gray-100 rounded p-2 max-h-48 overflow-y-auto">{{ finding.raw_status_json }}</pre>
    {% endif %}
  </div>
</div>
{% endmacro %}
