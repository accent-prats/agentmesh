{% extends "base.html.j2" %}
{% block title %}{{ report.run.scope_name }} report{% endblock %}

{% block content %}
<div class="max-w-4xl mx-auto px-8 py-10">

  <a href="../.." class="inline-flex items-center gap-1.5 text-xs text-gray-400 hover:text-brand mb-4">
    <i data-lucide="arrow-left" class="w-3 h-3"></i> Console
  </a>

  <h1 class="text-2xl font-bold text-gray-900 tracking-tight">Fleet report</h1>
  <p class="text-sm text-gray-500 mt-1 mb-6">
    {{ report.run.scope_name }} &middot; run {{ report.run.run_id }} &middot;
    {{ report.run.started_at.strftime('%Y-%m-%d %H:%M UTC') }}
  </p>

  <div class="grid grid-cols-3 sm:grid-cols-6 gap-px bg-gray-100 border border-gray-100 rounded-xl overflow-hidden mb-2">
    <div class="bg-white px-4 py-3.5"><b class="block text-2xl font-bold text-gray-900 tabular-nums">{{ report.total_machines }}</b><span class="block text-[11px] text-gray-400 mt-1">Total machines</span></div>
    <div class="bg-white px-4 py-3.5">
      <b class="block text-2xl font-bold text-gray-900 tabular-nums">{{ report.total_failed }}</b>
      <span class="block text-[11px] text-gray-400 mt-1">
        Failed
        {% if report.trend %}
          {% if report.trend.failed_delta < 0 %}<span class="text-emerald-600 font-semibold">&darr;{{ -report.trend.failed_delta }}</span>
          {% elif report.trend.failed_delta > 0 %}<span class="text-red-600 font-semibold">&uarr;{{ report.trend.failed_delta }}</span>
          {% else %}<span class="text-gray-400">&middot; flat</span>{% endif %}
        {% endif %}
      </span>
    </div>
    <div class="bg-white px-4 py-3.5"><b class="block text-2xl font-bold text-gray-900 tabular-nums">{{ report.total_clusters }}</b><span class="block text-[11px] text-gray-400 mt-1">Distinct causes</span></div>
    <div class="bg-white px-4 py-3.5">
      <b class="block text-2xl font-bold text-gray-900 tabular-nums">{{ report.compliance_pct }}%</b>
      <span class="block text-[11px] text-gray-400 mt-1">
        Compliance
        {% if report.trend %}
          {% if report.trend.compliance_delta_pct > 0 %}<span class="text-emerald-600 font-semibold">&uarr;{{ report.trend.compliance_delta_pct }}</span>
          {% elif report.trend.compliance_delta_pct < 0 %}<span class="text-red-600 font-semibold">&darr;{{ -report.trend.compliance_delta_pct }}</span>
          {% else %}<span class="text-gray-400">&middot; flat</span>{% endif %}
        {% endif %}
      </span>
    </div>
    <div class="bg-white px-4 py-3.5"><b class="block text-2xl font-bold text-gray-900 tabular-nums">{{ report.repeat_offender_count }}</b><span class="block text-[11px] text-gray-400 mt-1">Repeat offenders</span></div>
    <div class="bg-white px-4 py-3.5"><b class="block text-2xl font-bold text-gray-900 tabular-nums">{{ report.unresolved_count }}</b><span class="block text-[11px] text-gray-400 mt-1">Unresolved</span></div>
  </div>
  {% if report.trend %}
  <p class="text-xs text-gray-400 mb-6">vs. previous cycle ({{ report.trend.previous_run_id }}): {{ report.trend.previous_total_failed }} failed, {{ report.trend.previous_compliance_pct }}% compliance, {{ report.trend.previous_repeat_offender_count }} repeat offender{{ 's' if report.trend.previous_repeat_offender_count != 1 else '' }}.</p>
  {% else %}
  <p class="text-xs text-gray-400 mb-6">No prior completed cycle for "{{ report.run.scope_name }}" yet to trend against.</p>
  {% endif %}

  {% if smtp_configured %}
  <div class="email-report-widget bg-white rounded-2xl shadow-sm border border-gray-100 p-4 mb-6" data-run-id="{{ report.run.run_id }}">
    <button type="button" class="email-report-toggle flex items-center gap-2 text-sm font-medium text-gray-700 hover:text-brand">
      <i data-lucide="mail" class="w-4 h-4"></i> Email report
      <i data-lucide="chevron-down" class="email-report-chevron w-3.5 h-3.5 text-gray-400 transition-transform"></i>
    </button>
    <div class="email-report-panel hidden mt-4 space-y-3">
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1.5">To</label>
        <input type="text" class="email-recipients-input w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-brand focus:border-brand focus:outline-none"
          placeholder="name@example.com, name2@example.com" value="{{ default_recipients|join(', ') }}">
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1.5">Note <span class="text-gray-400 font-normal">(optional)</span></label>
        <textarea class="email-note-input w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-brand focus:border-brand focus:outline-none" rows="2" placeholder="Shown above the report summary in the email&hellip;"></textarea>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <input type="text" class="email-requested-by-input border border-gray-200 rounded-lg px-2.5 py-1.5 text-xs w-44" placeholder="your email">
        <button type="button" class="email-send-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-brand hover:bg-brand-dark text-white">Send</button>
        <span class="email-status text-xs text-gray-400"></span>
      </div>
    </div>
  </div>
  {% endif %}

  {% if report.machine_rows %}
  {# Discovery only ever pulls in non-Succeeded machines in the first place
     (pipeline/discovery.py's Resource Graph query explicitly excludes them),
     so every row here is some flavor of "didn't succeed" - a "Succeeded"
     filter chip would structurally always read 0, in the demo and in
     every real deployment alike. Found 2026-10-13 reviewing this exact
     table - two buckets, not three. #}
  {% set ns = namespace(failed=0, other=0) %}
  {% for row in report.machine_rows %}
    {% set st = (row.outcome.status if row.outcome else '')|lower %}
    {% if st == 'failed' %}{% set ns.failed = ns.failed + 1 %}
    {% else %}{% set ns.other = ns.other + 1 %}{% endif %}
  {% endfor %}
  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden mb-6">
    <div class="px-6 py-4 border-b border-gray-100 flex flex-wrap items-center gap-2.5">
      <h2 class="font-semibold text-gray-900 text-sm mr-1">Failed machines</h2>
      <div id="fr-status-filters" class="flex flex-wrap items-center gap-1.5">
        <button type="button" data-status="all" class="fr-filter-chip text-[11px] font-medium px-2.5 py-1 rounded-full border transition-colors bg-gray-900 text-white border-gray-900">All &middot; {{ report.machine_rows|length }}</button>
        <button type="button" data-status="failed" class="fr-filter-chip text-[11px] font-medium px-2.5 py-1 rounded-full border transition-colors bg-white text-gray-500 border-gray-200 hover:bg-gray-50">Failed &middot; {{ ns.failed }}</button>
        <button type="button" data-status="other" class="fr-filter-chip text-[11px] font-medium px-2.5 py-1 rounded-full border transition-colors bg-white text-gray-500 border-gray-200 hover:bg-gray-50">Other &middot; {{ ns.other }}</button>
      </div>
      <input type="text" id="fr-search" placeholder="Search machine or cause&hellip;"
        class="ml-auto border border-gray-200 rounded-lg px-3 py-1.5 text-xs w-56 focus:ring-2 focus:ring-brand focus:border-brand focus:outline-none">
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-sm" id="fr-table">
        <thead>
          <tr class="text-[10px] font-semibold uppercase tracking-wide text-gray-400 border-b border-gray-100">
            <th class="text-left px-5 py-2.5 cursor-pointer select-none" data-sort="vmName">Machine <span class="fr-sort-arrow"></span></th>
            <th class="text-left px-3 py-2.5 cursor-pointer select-none" data-sort="status">Status <span class="fr-sort-arrow"></span></th>
            <th class="text-left px-3 py-2.5">Failed update</th>
            <th class="text-left px-3 py-2.5">Root cause</th>
            <th class="text-left px-3 py-2.5 cursor-pointer select-none" data-sort="confidence">Confidence <span class="fr-sort-arrow"></span></th>
            <th class="text-left px-5 py-2.5">Fix</th>
          </tr>
        </thead>
        <tbody>
          {% for row in report.machine_rows %}
          {% set st = (row.outcome.status if row.outcome else '')|lower %}
          {% set st_bucket = 'failed' if st == 'failed' else 'other' %}
          <tr class="border-b border-gray-50 hover:bg-gray-50/70"
            data-vm-name="{{ row.vm_name|lower }}" data-title="{{ row.title|lower }}"
            data-status="{{ st_bucket }}" data-confidence="{{ row.confidence }}">
            <td class="px-5 py-2.5 font-mono text-[12.5px] whitespace-nowrap">
              <a href="{{ report.run.run_id }}/machines/{{ row.vm_name }}.html" class="text-brand hover:underline">{{ row.vm_name }}</a>
            </td>
            <td class="px-3 py-2.5 whitespace-nowrap">
              {% if row.outcome %}
                {% if st == 'failed' %}
                <span class="text-[10px] font-semibold uppercase tracking-wide px-2 py-0.5 rounded-full bg-red-50 text-red-600 border border-red-200">{{ row.outcome.status }}</span>
                {% elif st == 'succeeded' %}
                <span class="text-[10px] font-semibold uppercase tracking-wide px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">{{ row.outcome.status }}</span>
                {% elif st == 'completedwithwarnings' %}
                <span class="text-[10px] font-semibold uppercase tracking-wide px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 border border-amber-200">{{ row.outcome.status }}</span>
                {% else %}
                <span class="text-[10px] font-semibold uppercase tracking-wide px-2 py-0.5 rounded-full bg-gray-50 text-gray-600 border border-gray-200">{{ row.outcome.status }}</span>
                {% endif %}
              {% else %}
              <span class="text-[10px] font-semibold uppercase tracking-wide px-2 py-0.5 rounded-full bg-gray-50 text-gray-400 border border-gray-200" title="No structured outcome recorded for this machine - this run predates per-machine outcome tracking.">Unknown</span>
              {% endif %}
            </td>
            <td class="px-3 py-2.5 font-mono text-[11.5px] text-gray-600 max-w-[160px]">
              {% if row.outcome and (row.outcome.kbs_failed or row.outcome.packages_failed) %}
              {% set failed_update = (row.outcome.kbs_failed + row.outcome.packages_failed)|join(', ') %}
              <div class="truncate" title="{{ failed_update }}">{{ failed_update }}</div>
              {% else %}&mdash;{% endif %}
            </td>
            <td class="px-3 py-2.5 max-w-[240px]">
              <a href="#cluster-{{ row.cluster_id }}" class="block truncate text-gray-700 hover:text-brand" title="{{ row.title }}">{{ row.title }}</a>
            </td>
            <td class="px-3 py-2.5 whitespace-nowrap">
              {% if row.confidence >= 0.8 %}
              <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">{{ '%.0f' % (row.confidence * 100) }}%</span>
              {% elif row.confidence >= 0.5 %}
              <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 border border-amber-200">{{ '%.0f' % (row.confidence * 100) }}%</span>
              {% else %}
              <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-red-50 text-red-600 border border-red-200">{{ '%.0f' % (row.confidence * 100) }}%</span>
              {% endif %}
            </td>
            <td class="px-5 py-2.5 whitespace-nowrap">
              {% if row.has_immediate_fix %}
              <span class="text-[9px] font-semibold uppercase px-1.5 py-0.5 rounded bg-emerald-50 text-emerald-700 border border-emerald-200">Yes</span>
              {% else %}
              <span class="text-[9px] font-semibold uppercase px-1.5 py-0.5 rounded bg-gray-50 text-gray-500 border border-gray-200">No</span>
              {% endif %}
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <p id="fr-empty-state" class="px-6 py-3 text-xs text-gray-400" style="display:none;">No machines match this filter.</p>
  </div>
  {% endif %}

  <div class="space-y-4">
  {% for entry in report.entries %}
  {% set conf = entry.result.confidence %}
  <div id="cluster-{{ entry.cluster.cluster_id }}" class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden target:ring-2 target:ring-brand/40 target:ring-offset-2 transition-shadow">
    <div class="px-6 py-5 border-b border-gray-100">
      <div class="flex flex-wrap items-center gap-1.5 mb-2.5">
        {% if conf >= 0.8 %}
          <span class="text-[10px] font-semibold uppercase tracking-wide px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">High confidence</span>
        {% elif conf >= 0.5 %}
          <span class="text-[10px] font-semibold uppercase tracking-wide px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 border border-amber-200">Medium confidence</span>
        {% else %}
          <span class="text-[10px] font-semibold uppercase tracking-wide px-2 py-0.5 rounded-full bg-red-50 text-red-600 border border-red-200">Low confidence</span>
        {% endif %}
        <span class="text-[10px] font-semibold uppercase tracking-wide px-2 py-0.5 rounded-full bg-sky-50 text-sky-700 border border-sky-200">{{ entry.cluster.size }} machine{{ 's' if entry.cluster.size != 1 else '' }}</span>
        <span class="text-[10px] font-semibold uppercase tracking-wide px-2 py-0.5 rounded-full bg-gray-50 text-gray-600 border border-gray-200">{{ '%.0f' % (conf * 100) }}% confidence</span>
        {% if entry.recurrence_badge %}
          <span class="text-[10px] font-semibold uppercase tracking-wide px-2 py-0.5 rounded-full bg-red-50 text-red-600 border border-red-200">{{ entry.recurrence_badge }}</span>
        {% endif %}
      </div>
      <h3 class="font-semibold text-gray-900 text-base leading-snug">{{ entry.result.title }}</h3>
      <p class="text-xs text-gray-400 mt-1">Cause family: {{ entry.result.cause_family.value }} &middot; origin: {{ entry.result.origin.value }}</p>
    </div>

    <div class="px-6 py-5 text-sm">
      {% if entry.result.causal_chain %}
      <h6 class="text-[10px] font-semibold uppercase tracking-wide text-gray-400 mb-2">Causal chain</h6>
      <ol class="space-y-1.5 mb-4 font-mono text-[12.5px] text-gray-600">
        {% for step in entry.result.causal_chain %}
        <li class="pl-3 border-l-2 border-gray-200">
          {{ step.statement }}
          <span class="block text-[10.5px] text-gray-400 mt-0.5">evidence: {{ step.evidence_refs|join(', ') }}</span>
        </li>
        {% endfor %}
      </ol>
      {% endif %}

      {% if entry.result.ruled_out %}
      <h6 class="text-[10px] font-semibold uppercase tracking-wide text-gray-400 mb-2">Ruled out</h6>
      <ul class="list-disc pl-4 mb-4 text-gray-600 space-y-1">
        {% for r in entry.result.ruled_out %}
        <li><b class="font-medium text-gray-700">{{ r.candidate }}</b> &mdash; {{ r.reason }}{% if r.evidence_refs %} <span class="text-[10.5px] text-gray-400">(evidence: {{ r.evidence_refs|join(', ') }})</span>{% endif %}</li>
        {% endfor %}
      </ul>
      {% endif %}

      {% if entry.result.missing_evidence %}
      <h6 class="text-[10px] font-semibold uppercase tracking-wide text-gray-400 mb-2">Missing evidence</h6>
      <ul class="list-disc pl-4 mb-4 text-gray-600 space-y-1">{% for m in entry.result.missing_evidence %}<li>{{ m }}</li>{% endfor %}</ul>
      {% endif %}

      {% if entry.result.remediation and entry.result.remediation.immediate_fix %}
      <h6 class="text-[10px] font-semibold uppercase tracking-wide text-gray-400 mb-2 flex items-center gap-1.5">
        Immediate fix
        <span class="text-[9px] font-semibold uppercase px-1.5 py-0.5 rounded bg-emerald-50 text-emerald-700 border border-emerald-200">{{ entry.result.remediation.immediate_risk.value }} risk</span>
        <span class="text-[9px] font-semibold uppercase px-1.5 py-0.5 rounded bg-sky-50 text-sky-700 border border-sky-200">{{ entry.result.remediation.immediate_scope }}</span>
      </h6>
      <ol class="list-decimal pl-4 mb-4 text-gray-600 space-y-1">{% for step in entry.result.remediation.immediate_fix %}<li>{{ step.instruction }}</li>{% endfor %}</ol>
      {% endif %}

      {% if entry.result.remediation and entry.result.remediation.preventive_fix %}
      <h6 class="text-[10px] font-semibold uppercase tracking-wide text-gray-400 mb-2 flex items-center gap-1.5">
        Preventive fix
        <span class="text-[9px] font-semibold uppercase px-1.5 py-0.5 rounded bg-amber-50 text-amber-700 border border-amber-200">{{ entry.result.remediation.preventive_risk.value }} risk</span>
      </h6>
      <p class="text-gray-600 mb-4">{{ entry.result.remediation.preventive_fix }}</p>
      {% endif %}

      {% if entry.result.remediation %}
      <h6 class="text-[10px] font-semibold uppercase tracking-wide text-gray-400 mb-2">Automation candidate</h6>
      <p class="text-gray-600 mb-4">
        {% if entry.result.remediation.phase2_candidate %}
          <span class="text-[9px] font-semibold uppercase px-1.5 py-0.5 rounded bg-emerald-50 text-emerald-700 border border-emerald-200">Yes</span>
        {% else %}
          <span class="text-[9px] font-semibold uppercase px-1.5 py-0.5 rounded bg-amber-50 text-amber-700 border border-amber-200">No</span>
        {% endif %}
        {{ entry.result.remediation.phase2_rationale }}
      </p>

      {% if entry.result.remediation.phase2_candidate and entry.result.cause_family in supported_action_families %}
        {% set fp = family_precision.get(entry.result.cause_family) %}
        {% set action_type = supported_action_families[entry.result.cause_family] %}
        {% set bar_met = fp and fp.meets_promotion_bar(promotion_threshold, promotion_min_sample) %}
        {% if remediation_enabled and bar_met %}
        <div class="remediation-widget mb-4 p-4 rounded-xl bg-gray-50 border border-gray-200"
          data-run-id="{{ report.run.run_id }}" data-cluster-id="{{ entry.cluster.cluster_id }}" data-action-type="{{ action_type.value }}">
          <h6 class="text-[10px] font-semibold uppercase tracking-wide text-gray-400 mb-2">Run remediation</h6>
          <p class="text-xs text-gray-500 mb-3">
            {{ entry.cluster.size }} machine{{ 's' if entry.cluster.size != 1 else '' }} in this cluster - all are
            targeted unless you uncheck one below.
          </p>
          <div class="flex flex-wrap gap-x-4 gap-y-1.5 mb-3 max-h-24 overflow-y-auto">
            {% for m in entry.cluster.members %}
            <label class="flex items-center gap-1.5 text-xs text-gray-600 cursor-pointer">
              <input type="checkbox" class="remediation-vm-checkbox accent-brand" value="{{ m.vm_id }}" checked> {{ m.vm_name }}
            </label>
            {% endfor %}
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <input type="text" class="requested-by-input border border-gray-200 rounded-lg px-2.5 py-1.5 text-xs w-40" placeholder="your email">
            <button type="button" class="remediation-run-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-brand hover:bg-brand-dark text-white">
              Remediate {{ entry.cluster.size }} machine{{ 's' if entry.cluster.size != 1 else '' }}
            </button>
            <span class="remediation-status text-xs text-gray-400"></span>
          </div>
          <div class="remediation-results mt-3 space-y-1 text-xs"></div>
        </div>
        {% elif bar_met %}
        <p class="text-xs text-gray-500 mb-4">
          {{ entry.result.cause_family.value|replace('_', ' ')|capitalize }} has cleared review
          ({{ fp.sample_size }}/{{ promotion_min_sample }} reviewed, {{ "%.0f"|format(fp.precision * 100) }}% precision)
          but automated remediation is turned off for this deployment.
        </p>
        {% elif fp %}
        <p class="text-xs text-gray-500 mb-4">
          Eligible once {{ entry.result.cause_family.value|replace('_', ' ') }} clears review:
          {{ fp.sample_size }}/{{ promotion_min_sample }} reviewed, {{ "%.0f"|format(fp.precision * 100) }}% precision
          (needs &ge;{{ "%.0f"|format(promotion_threshold * 100) }}%).
        </p>
        {% else %}
        <p class="text-xs text-gray-500 mb-4">
          Eligible once {{ entry.result.cause_family.value|replace('_', ' ') }} clears review:
          0/{{ promotion_min_sample }} reviewed.
        </p>
        {% endif %}
      {% endif %}
      {% endif %}

      <p class="text-xs text-gray-400 pt-3 mt-1 border-t border-gray-100">
        Affected:
        {% for m in entry.cluster.members[:8] %}<a href="{{ report.run.run_id }}/machines/{{ m.vm_name }}.html" class="text-brand hover:underline">{{ m.vm_name }}</a>{% if not loop.last %}, {% endif %}{% endfor %}{% if entry.cluster.size > 8 %} &hellip; +{{ entry.cluster.size - 8 }} more{% endif %}
      </p>

      <div class="verdict-widget mt-4 pt-4 border-t border-gray-100" data-cluster-id="{{ entry.cluster.cluster_id }}" data-cause-family="{{ entry.result.cause_family.value }}">
        <h6 class="text-[10px] font-semibold uppercase tracking-wide text-gray-400 mb-2">Was this finding right?</h6>
        <div class="flex flex-wrap items-center gap-2">
          <input type="text" class="reviewer-input border border-gray-200 rounded-lg px-2.5 py-1.5 text-xs w-40" placeholder="your email">
          <button type="button" class="verdict-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200 hover:bg-emerald-100" data-verdict="correct">Correct</button>
          <button type="button" class="verdict-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-amber-50 text-amber-700 border border-amber-200 hover:bg-amber-100" data-verdict="partially_correct">Partially correct</button>
          <button type="button" class="verdict-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-red-50 text-red-600 border border-red-200 hover:bg-red-100" data-verdict="wrong">Wrong</button>
          <span class="verdict-status text-xs text-gray-400"></span>
        </div>
      </div>
    </div>
  </div>
  {% endfor %}
  </div>

</div>
{% endblock %}

{% block scripts %}
<script>
// Machine table: client-side search, status filter, and column sort -
// every row's already in the page (one run's worth of machines, not a
// paginated dataset), so there's no need for a server round-trip to
// slice this any differently.
(function () {
  const table = document.getElementById('fr-table');
  if (!table) return;

  const tbody = table.querySelector('tbody');
  const rows = Array.from(tbody.querySelectorAll('tr'));
  const search = document.getElementById('fr-search');
  const emptyState = document.getElementById('fr-empty-state');
  const chips = Array.from(document.querySelectorAll('#fr-status-filters .fr-filter-chip'));
  let activeStatus = 'all';

  const chipActive = 'fr-filter-chip text-[11px] font-medium px-2.5 py-1 rounded-full border transition-colors bg-gray-900 text-white border-gray-900';
  const chipInactive = 'fr-filter-chip text-[11px] font-medium px-2.5 py-1 rounded-full border transition-colors bg-white text-gray-500 border-gray-200 hover:bg-gray-50';

  function applyFilters() {
    const q = (search.value || '').trim().toLowerCase();
    let visible = 0;
    rows.forEach(function (row) {
      const matchesStatus = activeStatus === 'all' || row.dataset.status === activeStatus;
      const matchesSearch = !q || row.dataset.vmName.includes(q) || row.dataset.title.includes(q);
      const show = matchesStatus && matchesSearch;
      row.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    emptyState.style.display = visible === 0 ? '' : 'none';
    table.style.display = visible === 0 ? 'none' : '';
  }

  search.addEventListener('input', applyFilters);
  chips.forEach(function (chip) {
    chip.className = chip.dataset.status === 'all' ? chipActive : chipInactive;
    chip.addEventListener('click', function () {
      chips.forEach(function (c) { c.className = chipInactive; });
      chip.className = chipActive;
      activeStatus = chip.dataset.status;
      applyFilters();
    });
  });

  table.querySelectorAll('th[data-sort]').forEach(function (th) {
    let ascending = true;
    th.addEventListener('click', function () {
      const key = th.dataset.sort;
      const sorted = rows.slice().sort(function (a, b) {
        const av = key === 'confidence' ? parseFloat(a.dataset.confidence) : a.dataset[key];
        const bv = key === 'confidence' ? parseFloat(b.dataset.confidence) : b.dataset[key];
        if (av < bv) return ascending ? -1 : 1;
        if (av > bv) return ascending ? 1 : -1;
        return 0;
      });
      table.querySelectorAll('.fr-sort-arrow').forEach(function (el) { el.textContent = ''; });
      th.querySelector('.fr-sort-arrow').textContent = ascending ? '↑' : '↓';
      ascending = !ascending;
      sorted.forEach(function (row) { tbody.appendChild(row); });
    });
  });
})();

document.querySelectorAll('.verdict-widget').forEach(function (widget) {
  const clusterId = widget.dataset.clusterId;
  const causeFamily = widget.dataset.causeFamily;
  const status = widget.querySelector('.verdict-status');
  const reviewerInput = widget.querySelector('.reviewer-input');

  widget.querySelectorAll('.verdict-btn').forEach(function (btn) {
    btn.addEventListener('click', async function () {
      const reviewer = reviewerInput.value.trim();
      if (!reviewer) {
        status.className = 'verdict-status text-xs text-red-600';
        status.textContent = 'Enter your email first.';
        return;
      }
      widget.querySelectorAll('.verdict-btn').forEach(b => b.disabled = true);
      status.className = 'verdict-status text-xs text-gray-400';
      status.textContent = 'Recording…';
      try {
        const res = await fetch('../../verdicts', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            cluster_id: clusterId,
            cause_family: causeFamily,
            verdict: btn.dataset.verdict,
            reviewer: reviewer,
          }),
        });
        if (!res.ok) throw new Error('HTTP ' + res.status);
        status.className = 'verdict-status text-xs text-emerald-600';
        status.textContent = 'Recorded - thank you.';
      } catch (err) {
        status.className = 'verdict-status text-xs text-red-600';
        status.textContent = 'Failed: ' + err.message;
        widget.querySelectorAll('.verdict-btn').forEach(b => b.disabled = false);
      }
    });
  });
});

// Maps the execute route's structured {reason: ...} rejection bodies to
// plain-English text - found in review: the fallback path (JSON.stringify
// of the raw detail object) would otherwise print the literal internal
// reason code (e.g. "not_phase2_candidate") straight onto the page, the
// same class of "internal field name leaking into UI text" issue this
// page's own "Automation candidate" heading was just cleaned up for.
function describeRemediationError(detail, statusCode) {
  if (typeof detail === 'string') return detail;
  if (detail && typeof detail === 'object' && detail.reason) {
    if (detail.reason === 'not_phase2_candidate') {
      return 'This diagnosis is not currently marked as an automation candidate.';
    }
    if (detail.reason === 'promotion_bar_not_met') {
      return 'This cause family no longer clears the precision gate (' + detail.sample_size + '/' + detail.min_sample +
        ' reviewed, ' + Math.round(detail.precision * 100) + '% precision, needs ≥' + Math.round(detail.threshold * 100) + '%).';
    }
    if (detail.reason === 'action_type_not_supported_for_cause_family') {
      return 'This action is not supported for this cause family.';
    }
  }
  return detail ? JSON.stringify(detail) : ('HTTP ' + statusCode);
}

document.querySelectorAll('.remediation-widget').forEach(function (widget) {
  const runId = widget.dataset.runId;
  const clusterId = widget.dataset.clusterId;
  const actionType = widget.dataset.actionType;
  const status = widget.querySelector('.remediation-status');
  const resultsEl = widget.querySelector('.remediation-results');
  const requestedByInput = widget.querySelector('.requested-by-input');
  const runBtn = widget.querySelector('.remediation-run-btn');

  runBtn.addEventListener('click', async function () {
    const requestedBy = requestedByInput.value.trim();
    if (!requestedBy) {
      status.className = 'remediation-status text-xs text-red-600';
      status.textContent = 'Enter your email first.';
      return;
    }
    const vmIds = Array.from(widget.querySelectorAll('.remediation-vm-checkbox:checked')).map(cb => cb.value);
    if (vmIds.length === 0) {
      status.className = 'remediation-status text-xs text-red-600';
      status.textContent = 'Select at least one machine.';
      return;
    }

    runBtn.disabled = true;
    status.className = 'remediation-status text-xs text-gray-400';
    status.textContent = 'Running…';
    resultsEl.innerHTML = '';

    try {
      const res = await fetch('../../remediation/runs/' + runId + '/clusters/' + clusterId + '/execute', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action_type: actionType, requested_by: requestedBy, vm_ids: vmIds }),
      });
      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        throw new Error(describeRemediationError(err.detail, res.status));
      }
      const body = await res.json();
      status.className = 'remediation-status text-xs ' + (body.failed_count > 0 ? 'text-amber-600' : 'text-emerald-600');
      status.textContent = body.succeeded_count + ' succeeded, ' + body.failed_count + ' failed.';
      body.results.forEach(function (r) {
        const row = document.createElement('div');
        row.className = 'flex items-center gap-2 ' + (r.status === 'success' ? 'text-emerald-700' : 'text-red-600');
        const dot = document.createElement('span');
        dot.className = 'inline-block w-1.5 h-1.5 rounded-full ' + (r.status === 'success' ? 'bg-emerald-500' : 'bg-red-500');
        row.appendChild(dot);
        row.appendChild(document.createTextNode(r.vm_name + ' — ' + r.message));
        resultsEl.appendChild(row);
      });
    } catch (err) {
      status.className = 'remediation-status text-xs text-red-600';
      status.textContent = 'Failed: ' + err.message;
    } finally {
      runBtn.disabled = false;
    }
  });
});

// Same "never show a raw {reason: ...} body on screen" discipline as
// describeRemediationError above - a different reason-code set (this
// route's own 409/400s), so a separate, small formatter rather than
// reusing one built around remediation's specific reason codes.
function describeEmailError(detail, statusCode) {
  if (typeof detail === 'string') return detail;
  if (detail && typeof detail === 'object' && detail.reason === 'smtp_not_configured') {
    return 'SMTP is not configured for this deployment yet - ask an admin to set it up under Settings → Email.';
  }
  return detail ? JSON.stringify(detail) : ('HTTP ' + statusCode);
}

document.querySelectorAll('.email-report-widget').forEach(function (widget) {
  const runId = widget.dataset.runId;
  const toggle = widget.querySelector('.email-report-toggle');
  const chevron = widget.querySelector('.email-report-chevron');
  const panel = widget.querySelector('.email-report-panel');
  const recipientsInput = widget.querySelector('.email-recipients-input');
  const noteInput = widget.querySelector('.email-note-input');
  const requestedByInput = widget.querySelector('.email-requested-by-input');
  const sendBtn = widget.querySelector('.email-send-btn');
  const status = widget.querySelector('.email-status');

  toggle.addEventListener('click', function () {
    const nowHidden = panel.classList.toggle('hidden');
    chevron.style.transform = nowHidden ? '' : 'rotate(180deg)';
  });

  sendBtn.addEventListener('click', async function () {
    const requestedBy = requestedByInput.value.trim();
    if (!requestedBy) {
      status.className = 'email-status text-xs text-red-600';
      status.textContent = 'Enter your email first.';
      return;
    }
    const recipients = recipientsInput.value.split(',').map(function (s) { return s.trim(); }).filter(Boolean);
    if (recipients.length === 0) {
      status.className = 'email-status text-xs text-red-600';
      status.textContent = 'Enter at least one recipient.';
      return;
    }

    sendBtn.disabled = true;
    status.className = 'email-status text-xs text-gray-400';
    status.textContent = 'Sending…';

    try {
      const res = await fetch('../../runs/' + runId + '/email', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ recipients: recipients, requested_by: requestedBy, note: noteInput.value.trim() }),
      });
      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        throw new Error(describeEmailError(err.detail, res.status));
      }
      const body = await res.json();
      status.className = 'email-status text-xs ' + (body.ok ? 'text-emerald-600' : 'text-red-600');
      status.textContent = body.message;
    } catch (err) {
      status.className = 'email-status text-xs text-red-600';
      status.textContent = 'Failed: ' + err.message;
    } finally {
      sendBtn.disabled = false;
    }
  });
});
</script>
{% endblock %}
