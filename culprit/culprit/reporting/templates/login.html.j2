<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Sign in | Culprit</title>
<script src="static/tailwind.js"></script>
<script>
  tailwind.config = { theme: { extend: { colors: {
    brand: { DEFAULT: '#E11D48', dark: '#9F1239' },
    navy: '#1C0A0F',
  } } } }
</script>
<script src="static/lucide.min.js"></script>
<style>body { font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }</style>
</head>
<body class="bg-navy min-h-screen flex items-center justify-center px-4">
  <div class="w-full max-w-sm">
    <div class="text-center mb-6">
      <div class="w-10 h-10 rounded-lg bg-brand/20 flex items-center justify-center mx-auto mb-3">
        <i data-lucide="search-x" class="w-4 h-4 text-brand-light"></i>
      </div>
      <h1 class="text-white font-bold text-lg">Culprit</h1>
      <p class="text-gray-400 text-xs mt-1">Sign in required</p>
    </div>

    <div class="bg-white rounded-2xl shadow-sm p-6 mb-4">
      <p class="text-sm text-gray-700 mb-3">
        <b>AgentMesh user?</b> Your session timed out - sign back in from the launcher
        and click the Culprit card again.
      </p>
      <a href="/"
        class="flex items-center justify-center gap-2 w-full bg-brand hover:bg-brand-dark text-white text-sm font-medium py-2.5 rounded-lg transition-colors">
        <i data-lucide="arrow-left" class="w-4 h-4"></i> Return to the AgentMesh Portal
      </a>
    </div>

    <details class="bg-white rounded-2xl shadow-sm p-6">
      <summary class="text-sm font-medium text-gray-600 cursor-pointer select-none">
        Direct/script access instead
      </summary>
      <form method="post" action="login" class="space-y-4 mt-4">
        <input type="hidden" name="next" value="{{ next_path }}">
        {% if error %}
        <div class="text-sm text-red-600 bg-red-50 border border-red-200 rounded-lg px-3 py-2">{{ error }}</div>
        {% endif %}
        <div>
          <label class="block text-xs font-medium text-gray-600 mb-1.5">Access token</label>
          <input type="password" name="token" required
            class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-brand focus:border-brand focus:outline-none">
        </div>
        <button type="submit"
          class="w-full bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium py-2.5 rounded-lg transition-colors">
          Sign in with token
        </button>
      </form>
    </details>
  </div>
  <script>lucide.createIcons();</script>
</body>
</html>
