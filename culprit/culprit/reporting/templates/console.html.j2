{% extends "base.html.j2" %}
{% block title %}Culprit{% endblock %}

{% block content %}
<div class="max-w-4xl mx-auto px-8 py-10">

  <div class="flex items-center gap-2 mb-1">
    <span class="inline-flex items-center gap-1.5 text-[11px] font-medium text-gray-500 bg-gray-100 px-2.5 py-1 rounded-full"
      title="Culprit diagnoses and recommends - it never takes automated action on your infrastructure.">
      <i data-lucide="eye" class="w-3 h-3"></i> Read-only
    </span>
  </div>
  <h1 class="text-2xl font-bold text-gray-900 tracking-tight mt-2">Culprit</h1>
  <p class="text-sm font-medium text-brand mt-0.5">Every failed patch has a culprit.</p>

  {% if dashboard.latest_run %}
  {% set report = dashboard.latest_run %}
  <p class="text-sm text-gray-500 mt-4">
    <span title="Culprit's own lookback window for this scan, not any specific Azure Update Manager maintenance job's time - see each machine's own page for its real patch job time. The scan itself ran at the end of this range.">Scan window <i data-lucide="info" class="w-3 h-3 inline -mt-0.5"></i>:</span>
    <span class="font-medium text-gray-700">{{ report.run.scope_name }}</span>
    &middot; {{ report.run.started_at | localtime }}{% if report.run.ended_at %} &ndash; {{ report.run.ended_at | localtime }}{% endif %}
    &middot; <a href="runs/{{ report.run.run_id }}/report.html" class="text-brand hover:underline font-medium">View full report &rarr;</a>
  </p>

  <div class="grid grid-cols-3 sm:grid-cols-6 gap-px bg-gray-100 border border-gray-100 rounded-xl overflow-hidden mt-4 mb-5">
    <div class="bg-white px-4 py-3.5"><b class="block text-2xl font-bold text-gray-900 tabular-nums">{{ report.total_machines }}</b><span class="block text-[11px] text-gray-400 mt-1">Total machines</span></div>
    <div class="bg-white px-4 py-3.5">
      <b class="block text-2xl font-bold text-gray-900 tabular-nums">{{ report.total_failed }}</b>
      <span class="block text-[11px] text-gray-400 mt-1">
        Failed
        {% if dashboard.failed_delta is not none %}
          {% if dashboard.failed_delta < 0 %}<span class="text-emerald-600 font-semibold">&darr;{{ -dashboard.failed_delta }}</span>
          {% elif dashboard.failed_delta > 0 %}<span class="text-red-600 font-semibold">&uarr;{{ dashboard.failed_delta }}</span>
          {% else %}<span class="text-gray-400">&middot; flat</span>{% endif %}
        {% endif %}
      </span>
    </div>
    <div class="bg-white px-4 py-3.5"><b class="block text-2xl font-bold text-gray-900 tabular-nums">{{ report.total_clusters }}</b><span class="block text-[11px] text-gray-400 mt-1">Distinct causes</span></div>
    <div class="bg-white px-4 py-3.5">
      <b class="block text-2xl font-bold text-gray-900 tabular-nums">{{ report.compliance_pct }}%</b>
      <span class="block text-[11px] text-gray-400 mt-1">
        Compliance
        {% if dashboard.compliance_delta_pct is not none %}
          {% if dashboard.compliance_delta_pct > 0 %}<span class="text-emerald-600 font-semibold">&uarr;{{ dashboard.compliance_delta_pct }}</span>
          {% elif dashboard.compliance_delta_pct < 0 %}<span class="text-red-600 font-semibold">&darr;{{ -dashboard.compliance_delta_pct }}</span>
          {% else %}<span class="text-gray-400">&middot; flat</span>{% endif %}
        {% endif %}
      </span>
    </div>
    <div class="bg-white px-4 py-3.5"><b class="block text-2xl font-bold text-gray-900 tabular-nums">{{ report.repeat_offender_count }}</b><span class="block text-[11px] text-gray-400 mt-1">Repeat offenders</span></div>
    <div class="bg-white px-4 py-3.5"><b class="block text-2xl font-bold text-gray-900 tabular-nums">{{ report.unresolved_count }}</b><span class="block text-[11px] text-gray-400 mt-1">Unresolved</span></div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mb-6">
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
      <h6 class="text-[10px] font-semibold uppercase tracking-wide text-gray-400 mb-3">
        Compliance trend &middot; last {{ dashboard.compliance_trend|length }} cycle{{ 's' if dashboard.compliance_trend|length != 1 else '' }}
      </h6>
      {% if trend_chart %}
      <div class="relative">
        <svg viewBox="0 0 {{ trend_chart.width }} {{ trend_chart.height }}" class="w-full" style="height:{{ trend_chart.height }}px" id="trend-svg">
          <polyline points="{{ trend_chart.polyline }}" fill="none" stroke="#E11D48" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          {% for pt in trend_chart.points %}
          <circle cx="{{ pt.x }}" cy="{{ pt.y }}" r="8" fill="transparent" class="trend-point" data-pct="{{ pt.pct }}%" data-date="{{ pt.date }}" style="cursor:pointer" />
          <circle cx="{{ pt.x }}" cy="{{ pt.y }}" r="3" fill="#E11D48" class="pointer-events-none" />
          {% endfor %}
        </svg>
        <div id="trend-tooltip" class="hidden absolute text-[11px] bg-gray-900 text-white px-2 py-1 rounded shadow-lg pointer-events-none whitespace-nowrap -translate-x-1/2 -translate-y-[130%]"></div>
      </div>
      <p class="text-[11px] text-gray-400 mt-2">
        {{ trend_chart.points[0].pct }}% &rarr; {{ trend_chart.points[-1].pct }}%
        across {{ trend_chart.points[0].date }}&ndash;{{ trend_chart.points[-1].date }}
      </p>
      {% else %}
      <p class="text-sm text-gray-400 py-7 text-center">
        Not enough completed cycles yet to chart a trend &mdash; this shows up after the
        next "{{ report.run.scope_name }}" run.
      </p>
      {% endif %}
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
      <h6 class="text-[10px] font-semibold uppercase tracking-wide text-gray-400 mb-3">
        Cause breakdown &middot; last {{ dashboard.compliance_trend|length }} cycle{{ 's' if dashboard.compliance_trend|length != 1 else '' }}
      </h6>
      {% if dashboard.top_causes %}
      <div class="space-y-2.5">
        {% for entry in dashboard.top_causes %}
        <div>
          <div class="flex items-center justify-between text-xs mb-1">
            <span class="text-gray-700 font-medium">{{ entry.cause_family.value|replace('_', ' ')|capitalize }}</span>
            <span class="text-gray-400 tabular-nums">{{ entry.machines }}</span>
          </div>
          <div class="h-1.5 bg-gray-100 rounded-full overflow-hidden">
            <div class="h-full bg-brand rounded-full" style="width: {{ (100 * entry.machines / dashboard.top_causes[0].machines) | round }}%"></div>
          </div>
        </div>
        {% endfor %}
      </div>
      {% else %}
      <p class="text-sm text-gray-400 py-7 text-center">No diagnosed causes in the last {{ dashboard.compliance_trend|length }} cycle{{ 's' if dashboard.compliance_trend|length != 1 else '' }}.</p>
      {% endif %}
    </div>
  </div>

  <div class="flex flex-wrap items-center gap-3">
    {% if demo_enabled %}
    <button id="run-btn" onclick="runDemo()"
      class="inline-flex items-center gap-2 bg-brand hover:bg-brand-dark text-white text-sm font-medium
             px-4 py-2.5 rounded-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
      <i data-lucide="zap" class="w-4 h-4"></i> Run demo scenario
    </button>
    {% endif %}
    <div class="inline-flex items-center gap-2 bg-white border border-gray-200 rounded-lg pl-3 pr-1.5 py-1.5">
      <label for="live-hours" class="text-xs text-gray-500">Hours back</label>
      <input id="live-hours" type="number" value="24" min="1" max="720"
        class="w-16 border border-gray-200 rounded px-1.5 py-1 text-sm focus:ring-2 focus:ring-brand focus:border-brand focus:outline-none">
      <button id="live-btn" onclick="runLive()"
        class="inline-flex items-center gap-1.5 bg-gray-900 hover:bg-black text-white text-sm font-medium
               px-3 py-1.5 rounded-md transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
        <i data-lucide="radar" class="w-3.5 h-3.5"></i> Run live analysis
      </button>
    </div>
    <span id="status" class="text-sm text-gray-500 min-h-[20px]"></span>
  </div>

  {% else %}
  <p class="text-gray-500 text-sm leading-relaxed mt-4 max-w-xl">
    Autonomous root-cause analysis for failed Azure Update Manager patch deployments &mdash;
    collapses hundreds of failures into a handful of distinct causes, settles the obvious
    ones with a deterministic rule engine, and hands the ambiguous tail to Claude for deep
    reasoning and remediation guidance.
  </p>

  {% if demo_enabled %}
  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-7 mt-8">
    <div class="flex items-center gap-3 mb-1">
      <div class="w-9 h-9 rounded-xl bg-brand/10 flex items-center justify-center shrink-0">
        <i data-lucide="play" class="w-4 h-4 text-brand"></i>
      </div>
      <h2 class="font-semibold text-gray-900">Demo scenario</h2>
    </div>
    <p class="text-sm text-gray-500 mt-2 mb-5">
      Runs the full pipeline against a synthetic 312-machine fleet with 47 realistic
      failures &mdash; no Azure or Datadog credentials required.
    </p>
    <button id="run-btn" onclick="runDemo()"
      class="flex items-center gap-2 bg-brand hover:bg-brand-dark text-white text-sm font-medium
             px-5 py-2.5 rounded-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
      <i data-lucide="zap" class="w-4 h-4"></i>
      Run patch-failure analysis
    </button>
    <div id="status" class="text-sm text-gray-500 mt-3 min-h-[20px]"></div>
  </div>
  {% endif %}

  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-7 {{ 'mt-5' if demo_enabled else 'mt-8' }}">
    <div class="flex items-center gap-3 mb-1">
      <div class="w-9 h-9 rounded-xl bg-gray-100 flex items-center justify-center shrink-0">
        <i data-lucide="radar" class="w-4 h-4 text-gray-500"></i>
      </div>
      <h2 class="font-semibold text-gray-900">Live analysis</h2>
    </div>
    <p class="text-sm text-gray-500 mt-2 mb-4">
      Diagnose real patch failures from your own Azure subscription and Datadog org -
      <a href="settings" class="font-medium text-brand hover:text-brand-dark">configure access first</a> if you haven't.
      Want this to run on its own? Set up a <a href="settings" class="font-medium text-brand hover:text-brand-dark">recurring schedule</a> instead.
    </p>
    <div class="flex items-end gap-3">
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1.5">Window (hours back)</label>
        <input id="live-hours" type="number" value="24" min="1" max="720"
          class="w-28 border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-brand focus:border-brand focus:outline-none">
      </div>
      <button id="live-btn" onclick="runLive('live-status')"
        class="flex items-center gap-2 bg-gray-900 hover:bg-black text-white text-sm font-medium
               px-5 py-2.5 rounded-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
        <i data-lucide="radar" class="w-4 h-4"></i> Run live analysis
      </button>
    </div>
    <div id="live-status" class="text-sm text-gray-500 mt-3 min-h-[20px]"></div>
  </div>
  {% endif %}

</div>
{% endblock %}

{% block scripts %}
<script>
async function runDemo() {
  const btn = document.getElementById('run-btn');
  const status = document.getElementById('status');
  btn.disabled = true;
  status.className = 'text-sm text-gray-500 min-h-[20px]';
  status.textContent = 'Collecting evidence, clustering, diagnosing…';
  try {
    const res = await fetch('runs/demo', { method: 'POST' });
    if (!res.ok) throw new Error('HTTP ' + res.status);
    const report = await res.json();
    status.textContent = report.total_failed + '/' + report.total_machines +
      ' machines failed, ' + report.total_clusters + ' distinct causes. Opening report…';
    window.location.href = 'runs/' + report.run.run_id + '/report.html';
  } catch (err) {
    status.className = 'text-sm text-red-600 min-h-[20px]';
    status.textContent = 'Run failed: ' + err.message;
    btn.disabled = false;
  }
}

// Shared by both the dashboard state's inline trigger (onclick="runLive()",
// reporting through the shared #status next to the demo button) and the
// empty state's own "Live analysis" card (onclick="runLive('live-status')",
// reporting into that card's own status line) - same request/response
// shape as settings.html.j2's old "Run a live analysis" card, which this
// replaces (moved here since triggering runs belongs on Console/Runs, not
// Settings - see runs.html.j2's own "trigger ... from the Console" copy).
async function runLive(statusElId) {
  statusElId = statusElId || 'status';
  const btn = document.getElementById('live-btn');
  const status = document.getElementById(statusElId);
  btn.disabled = true;
  status.className = 'text-sm text-gray-500 min-h-[20px]';
  status.textContent = 'Discovering failed machines and diagnosing…';
  try {
    const hours = parseInt(document.getElementById('live-hours').value, 10) || 24;
    // scope_name deliberately omitted - it's the join key _previous_completed_run/
    // compliance_trend use to match an ad-hoc run against its own prior cycle
    // (repository.py), so it must stay a stable constant across runs rather than
    // vary with whatever window_hours the user happens to pick. Let the server's
    // own default (routes_runs.py::LiveRunRequest.scope_name) supply it.
    const res = await fetch('runs/live', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ window_hours: hours }) });
    if (!res.ok) { const err = await res.json(); throw new Error(err.detail || ('HTTP ' + res.status)); }
    const report = await res.json();
    status.textContent = report.total_failed + '/' + report.total_machines +
      ' machines failed, ' + report.total_clusters + ' distinct causes. Opening report…';
    window.location.href = 'runs/' + report.run.run_id + '/report.html';
  } catch (err) {
    status.className = 'text-sm text-red-600 min-h-[20px]';
    status.textContent = 'Live run failed: ' + err.message;
    btn.disabled = false;
  }
}

// Compliance trend hover - the invisible, generously-sized circle is the
// hit target (an 8px-radius dot at this chart's scale is too small to
// hover reliably); the visible 3px dot stays purely decorative.
document.querySelectorAll('.trend-point').forEach(function (hitCircle) {
  hitCircle.addEventListener('mouseenter', function () {
    const svg = document.getElementById('trend-svg');
    const tooltip = document.getElementById('trend-tooltip');
    const svgRect = svg.getBoundingClientRect();
    const pt = svg.createSVGPoint();
    pt.x = hitCircle.cx.baseVal.value;
    pt.y = hitCircle.cy.baseVal.value;
    const screenPt = pt.matrixTransform(svg.getScreenCTM());
    tooltip.textContent = hitCircle.dataset.date + ' — ' + hitCircle.dataset.pct;
    tooltip.style.left = (screenPt.x - svgRect.left) + 'px';
    tooltip.style.top = (screenPt.y - svgRect.top) + 'px';
    tooltip.classList.remove('hidden');
  });
  hitCircle.addEventListener('mouseleave', function () {
    document.getElementById('trend-tooltip').classList.add('hidden');
  });
});
</script>
{% endblock %}
