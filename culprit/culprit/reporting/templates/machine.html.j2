{% extends "base.html.j2" %}
{% import "_evidence_gap.html.j2" as eg %}
{% block title %}{{ member.vm_name }}{% endblock %}

{% block content %}
<div class="max-w-3xl mx-auto px-8 py-10">

  <a href="../../../runs/{{ cluster.run_id }}/report.html" class="inline-flex items-center gap-1.5 text-xs text-gray-400 hover:text-brand mb-4">
    <i data-lucide="arrow-left" class="w-3 h-3"></i> Back to fleet report
  </a>

  <div class="flex items-start justify-between gap-4 mb-1">
    <h1 class="text-2xl font-bold text-gray-900 tracking-tight">{{ member.vm_name }}</h1>
    {% if result %}
      {% set conf = result.confidence %}
      {% if conf >= 0.8 %}
      <span class="shrink-0 text-[10px] font-semibold uppercase tracking-wide px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">High confidence</span>
      {% elif conf >= 0.5 %}
      <span class="shrink-0 text-[10px] font-semibold uppercase tracking-wide px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 border border-amber-200">Medium confidence</span>
      {% else %}
      <span class="shrink-0 text-[10px] font-semibold uppercase tracking-wide px-2 py-0.5 rounded-full bg-red-50 text-red-600 border border-red-200">Low confidence</span>
      {% endif %}
    {% endif %}
  </div>
  <p class="text-sm text-gray-500 mt-1 mb-6">
    {{ member.vm_id }}
    <a href="https://portal.azure.com/#@/resource{{ member.vm_id }}/overview" target="_blank" rel="noopener"
      class="inline-flex items-center gap-1 ml-2 text-brand hover:text-brand-dark font-medium">
      <i data-lucide="external-link" class="w-3 h-3"></i> Open in Azure Portal
    </a>
  </p>

  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 mb-4">
    <h6 class="text-[10px] font-semibold uppercase tracking-wide text-gray-400 mb-2 flex items-center gap-1.5">
      <i data-lucide="x-circle" class="w-3.5 h-3.5 text-gray-400"></i> What failed
    </h6>
    {% if outcome %}
    <div class="flex flex-wrap items-center gap-1.5 mb-3">
      {% set st = outcome.status|lower %}
      {% if st == 'failed' %}
      <span class="text-[10px] font-semibold uppercase tracking-wide px-2 py-0.5 rounded-full bg-red-50 text-red-600 border border-red-200">{{ outcome.status }}</span>
      {% elif st == 'succeeded' %}
      <span class="text-[10px] font-semibold uppercase tracking-wide px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">{{ outcome.status }}</span>
      {% elif st == 'completedwithwarnings' %}
      <span class="text-[10px] font-semibold uppercase tracking-wide px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 border border-amber-200">{{ outcome.status }}</span>
      {% else %}
      <span class="text-[10px] font-semibold uppercase tracking-wide px-2 py-0.5 rounded-full bg-gray-50 text-gray-600 border border-gray-200">{{ outcome.status }}</span>
      {% endif %}
      {% if outcome.error_code %}
      <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-gray-50 text-gray-600 border border-gray-200">{{ outcome.error_code }}</span>
      {% endif %}
    </div>
    {% if outcome.error_message %}
    <p class="text-sm text-gray-700 mb-3">{{ outcome.error_message }}</p>
    {% endif %}
    <div class="grid grid-cols-2 gap-x-6 gap-y-2 text-xs text-gray-500">
      {% if outcome.kbs_failed %}
      <div><span class="text-gray-400">Failed KB(s):</span> <span class="font-mono text-gray-700">{{ outcome.kbs_failed | join(', ') }}</span></div>
      {% endif %}
      {% if outcome.packages_failed %}
      <div><span class="text-gray-400">Failed package(s):</span> <span class="font-mono text-gray-700">{{ outcome.packages_failed | join(', ') }}</span></div>
      {% endif %}
      {% if outcome.reboot_status %}
      <div><span class="text-gray-400">Reboot status:</span> {{ outcome.reboot_status }}</div>
      {% endif %}
      {% if outcome.started_at %}
      <div>
        <span class="text-gray-400">Window:</span>
        {{ outcome.started_at | localtime }}{% if outcome.ended_at %} &ndash; {{ outcome.ended_at | localtime }}{% endif %}{% if outcome.window_minutes %} ({{ outcome.window_minutes }} min){% endif %}
      </div>
      {% endif %}
    </div>
    {% if evidence_gaps %}
    <div class="mt-3 pt-3 border-t border-gray-100">
      <h6 class="text-[10px] font-semibold uppercase tracking-wide text-amber-600 mb-2 flex items-center gap-1.5">
        <i data-lucide="alert-triangle" class="w-3 h-3"></i> Incomplete evidence
        <span class="normal-case font-normal text-gray-400">&middot; {{ evidence_gaps|length }} source{{ 's' if evidence_gaps|length != 1 else '' }} couldn't be collected</span>
      </h6>
      <div class="space-y-2">
        {% for gap in evidence_gaps %}{{ eg.evidence_gap_card(gap) }}{% endfor %}
      </div>
    </div>
    {% endif %}
    {% else %}
    <p class="text-sm text-gray-400">No structured outcome recorded for this machine - this run predates per-machine outcome tracking. See the cluster's shared finding below.</p>
    {% endif %}
  </div>

  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 mb-4
    {%- if result %}{% set conf = result.confidence %}
      {%- if conf >= 0.8 %} border-l-4 border-l-emerald-400
      {%- elif conf >= 0.5 %} border-l-4 border-l-amber-400
      {%- else %} border-l-4 border-l-red-400{% endif %}
    {%- endif %}">
    <h6 class="text-[10px] font-semibold uppercase tracking-wide text-gray-400 mb-2 flex items-center gap-1.5">
      <i data-lucide="search" class="w-3.5 h-3.5 text-gray-400"></i> Root cause
    </h6>
    {% if result %}
    <p class="text-sm text-gray-800 font-medium">{{ result.title }}</p>
    <p class="text-xs text-gray-400 mt-1">
      Cause family: {{ result.cause_family.value }} &middot; origin: {{ result.origin.value }} &middot;
      {{ cluster.size }} machine{{ 's' if cluster.size != 1 else '' }} in this cluster
    </p>

    {% if result.causal_chain %}
    <h6 class="text-[10px] font-semibold uppercase tracking-wide text-gray-400 mt-4 mb-2">Causal chain</h6>
    <ol class="space-y-1.5 font-mono text-[12.5px] text-gray-600">
      {% for step in result.causal_chain %}
      <li class="pl-3 border-l-2 border-gray-200">
        {{ step.statement }}
        <span class="block text-[10.5px] text-gray-400 mt-0.5">evidence: {{ step.evidence_refs|join(', ') }}</span>
      </li>
      {% endfor %}
    </ol>
    {% endif %}

    {% if result.ruled_out %}
    <h6 class="text-[10px] font-semibold uppercase tracking-wide text-gray-400 mt-4 mb-2">Ruled out</h6>
    <ul class="list-disc pl-4 text-sm text-gray-600 space-y-1">
      {% for r in result.ruled_out %}
      <li><b class="font-medium text-gray-700">{{ r.candidate }}</b> &mdash; {{ r.reason }}{% if r.evidence_refs %} <span class="text-[10.5px] text-gray-400">(evidence: {{ r.evidence_refs|join(', ') }})</span>{% endif %}</li>
      {% endfor %}
    </ul>
    {% endif %}
    {% else %}
    <p class="text-sm text-gray-400">This cluster has not been diagnosed yet.</p>
    {% endif %}
  </div>

  {% if evidence_timeline or log_usage %}
  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 mb-4">
    <h6 class="text-[10px] font-semibold uppercase tracking-wide text-gray-400 mb-2 flex items-center gap-1.5">
      <i data-lucide="history" class="w-3.5 h-3.5 text-gray-400"></i> Evidence timeline
      <span class="normal-case font-normal text-gray-400">&middot; every log reviewed this run, what it found, and what didn't contribute</span>
    </h6>
    <button type="button" class="eg-detail-toggle text-[11px] text-brand hover:text-brand-dark inline-flex items-center gap-1">
      <i data-lucide="chevron-right" class="eg-detail-chevron w-3 h-3 transition-transform"></i> Show full timeline
    </button>
    <div class="eg-detail-panel hidden mt-3 space-y-4">
      {% if log_usage %}
      <div>
        <h6 class="text-[10px] font-semibold uppercase tracking-wide text-gray-400 mb-1">
          Logs reviewed this run
          <span class="normal-case font-normal text-gray-400">&middot; {{ log_usage|length }} log/source, used or not, each with why</span>
        </h6>
        <ul>{% for entry in log_usage %}{{ eg.log_usage_row(entry) }}{% endfor %}</ul>
      </div>
      {% endif %}
      {% if evidence_timeline %}
      <div>
        <h6 class="text-[10px] font-semibold uppercase tracking-wide text-gray-400 mb-1">
          Full event-by-event timeline
          <span class="normal-case font-normal text-gray-400">&middot; {{ evidence_timeline|length }} event{{ 's' if evidence_timeline|length != 1 else '' }} the diagnosis above was reasoned from</span>
        </h6>
        <ol class="space-y-1.5 max-h-96 overflow-y-auto pr-1">
          {% for event in evidence_timeline %}
          <li class="flex items-start gap-2 pl-2 border-l-2 border-gray-200 text-xs">
            <i data-lucide="{{ event.icon }}" class="w-3.5 h-3.5 text-gray-400 shrink-0 mt-0.5"></i>
            <div class="min-w-0">
              <span class="text-gray-400 font-mono text-[10.5px]">{{ event.ts | localtime }}</span>
              <span class="text-gray-400">&middot; {{ event.source_label }}</span>
              <p class="text-gray-700">{{ event.summary }}</p>
              <span class="block text-[10.5px] text-gray-400">{{ event.raw_ref }}</span>
            </div>
          </li>
          {% endfor %}
        </ol>
      </div>
      {% endif %}
    </div>
  </div>
  {% endif %}

  {% if rca_missing_evidence %}
  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 mb-4">
    <h6 class="text-[10px] font-semibold uppercase tracking-wide text-amber-600 mb-2 flex items-center gap-1.5">
      <i data-lucide="alert-triangle" class="w-3.5 h-3.5"></i> Analysis notes
      <span class="normal-case font-normal text-gray-400">&middot; evidence gaps and anything that limited this diagnosis</span>
    </h6>
    <div class="space-y-2">
      {% for gap in rca_missing_evidence %}{{ eg.evidence_gap_card(gap) }}{% endfor %}
    </div>
  </div>
  {% endif %}

  {% if result and result.remediation %}
  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 mb-4">
    <h6 class="text-[10px] font-semibold uppercase tracking-wide text-gray-400 mb-2 flex items-center gap-1.5">
      <i data-lucide="wrench" class="w-3.5 h-3.5 text-gray-400"></i> Recommended fix
    </h6>
    {% if result.remediation.immediate_fix %}
    <h6 class="text-[10px] font-semibold uppercase tracking-wide text-gray-400 mb-2 flex items-center gap-1.5">
      Immediate fix
      <span class="text-[9px] font-semibold uppercase px-1.5 py-0.5 rounded bg-emerald-50 text-emerald-700 border border-emerald-200">{{ result.remediation.immediate_risk.value }} risk</span>
      <span class="text-[9px] font-semibold uppercase px-1.5 py-0.5 rounded bg-sky-50 text-sky-700 border border-sky-200">{{ result.remediation.immediate_scope }}</span>
    </h6>
    <ol class="list-decimal pl-4 mb-4 text-sm text-gray-600 space-y-1">{% for step in result.remediation.immediate_fix %}<li>{{ step.instruction }}</li>{% endfor %}</ol>
    {% endif %}

    {% if result.remediation.preventive_fix %}
    <h6 class="text-[10px] font-semibold uppercase tracking-wide text-gray-400 mb-2 flex items-center gap-1.5">
      Preventive fix
      <span class="text-[9px] font-semibold uppercase px-1.5 py-0.5 rounded bg-amber-50 text-amber-700 border border-amber-200">{{ result.remediation.preventive_risk.value }} risk</span>
    </h6>
    <p class="text-sm text-gray-600 mb-4">{{ result.remediation.preventive_fix }}</p>
    {% endif %}

    <h6 class="text-[10px] font-semibold uppercase tracking-wide text-gray-400 mb-2">Automation candidate</h6>
    <p class="text-sm text-gray-600">
      {% if result.remediation.phase2_candidate %}
        <span class="text-[9px] font-semibold uppercase px-1.5 py-0.5 rounded bg-emerald-50 text-emerald-700 border border-emerald-200">Yes</span>
      {% else %}
        <span class="text-[9px] font-semibold uppercase px-1.5 py-0.5 rounded bg-amber-50 text-amber-700 border border-amber-200">No</span>
      {% endif %}
      {{ result.remediation.phase2_rationale }}
    </p>
    <p class="text-xs text-gray-400 mt-2">To act on this, use the "Run remediation" control on the <a href="../../../runs/{{ cluster.run_id }}/report.html#cluster-{{ cluster.cluster_id }}" class="text-brand hover:underline">cluster's own card</a> in the Fleet Report - it targets every affected machine at once.</p>
  </div>
  {% endif %}

  {% if azure_error_details %}
  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 mb-4">
    <h6 class="text-[10px] font-semibold uppercase tracking-wide text-gray-400 mb-2 flex items-center gap-1.5">
      <i data-lucide="x-circle" class="w-3.5 h-3.5 text-red-500"></i> Azure-reported install errors
      <span class="normal-case font-normal text-gray-400">&middot; from Azure Update Manager's own patch installation result, independent of guest collection</span>
    </h6>
    <div class="space-y-2">
      {% for detail in azure_error_details %}{{ eg.azure_error_card(detail) }}{% endfor %}
    </div>
  </div>
  {% endif %}

  {% if extension_findings %}
  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 mb-4">
    <h6 class="text-[10px] font-semibold uppercase tracking-wide text-gray-400 mb-2 flex items-center gap-1.5">
      <i data-lucide="file-warning" class="w-3.5 h-3.5 text-amber-500"></i> Patch extension report
      <span class="normal-case font-normal text-gray-400">&middot; direct from the guest extension Azure Update Manager itself invokes</span>
    </h6>
    <div class="space-y-2">
      {% for finding in extension_findings %}{{ eg.extension_finding_card(finding) }}{% endfor %}
    </div>
  </div>
  {% endif %}

  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 mb-4">
    <h6 class="text-[10px] font-semibold uppercase tracking-wide text-gray-400 mb-2 flex items-center gap-1.5">
      <i data-lucide="radar" class="w-3.5 h-3.5 text-gray-400"></i> How this machine differs from the cluster's representative
    </h6>
    {% if member.vm_id == cluster.representative_vm_id %}
    <p class="text-sm text-gray-500">This machine <em>is</em> the cluster's representative member - its evidence bundle is what the RCA above was diagnosed from directly.</p>
    {% elif member.deviation_notes %}
    <ul class="list-disc pl-4 text-sm text-gray-600 space-y-1">
      {% for note in member.deviation_notes %}<li>{{ note }}</li>{% endfor %}
    </ul>
    {% else %}
    <p class="text-sm text-gray-500">No deviations recorded - this machine's evidence matched the cluster's representative closely enough that the same finding applies to it directly.</p>
    {% endif %}
  </div>

  {% set siblings = cluster.members | rejectattr('vm_id', 'equalto', member.vm_id) | list %}
  {% if siblings %}
  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
    <h6 class="text-[10px] font-semibold uppercase tracking-wide text-gray-400 mb-2 flex items-center gap-1.5">
      <i data-lucide="list-checks" class="w-3.5 h-3.5 text-gray-400"></i> Other machines with this cause
    </h6>
    <p class="text-sm text-gray-600">
      {% for m in siblings[:8] %}<a href="{{ m.vm_name }}.html" class="text-brand hover:underline">{{ m.vm_name }}</a>{% if not loop.last %}, {% endif %}{% endfor %}{% if siblings|length > 8 %} &hellip; +{{ siblings|length - 8 }} more{% endif %}
    </p>
  </div>
  {% endif %}

</div>
{% endblock %}
