# Copy to .env and fill in for a real deployment. Every value has a safe
# default for local/demo use (see culprit/config.py) - none of these are
# required to run the demo or the test suite.

# --- Database -----------------------------------------------------------
CULPRIT_DATABASE_URL=postgresql+psycopg://culprit:culprit@localhost:5432/culprit

# --- Azure ----------------------------------------------------------------
# DefaultAzureCredential handles auth (managed identity in prod, `az login`
# locally) - no client secret is read directly by this app.
CULPRIT_SUBSCRIPTION_IDS=00000000-0000-0000-0000-000000000000
CULPRIT_LOG_ANALYTICS_WORKSPACE_ID=

# --- Datadog (standard Datadog client env vars) ---------------------------
DD_API_KEY=
DD_APP_KEY=
DD_SITE=datadoghq.com

# --- Claude / Anthropic ----------------------------------------------------
ANTHROPIC_API_KEY=
CULPRIT_RCA_MODEL=claude-opus-5

# --- Notifications ----------------------------------------------------------
CULPRIT_TEAMS_WEBHOOK_URL=
CULPRIT_SLACK_WEBHOOK_URL=
# Public URL this app is reachable at (reverse-proxy prefix included, e.g.
# https://portal.local/culprit) - only used by the scheduler/event-driven
# notify path to build a working "Open full report" link in the digest,
# since there's no inbound HTTP request there to derive one from the way
# an ad-hoc /runs/live trigger has. Leave unset to omit the link.
CULPRIT_PUBLIC_URL=

# --- Autonomy (proposal Section 10) -----------------------------------------
# Off by default - a deployment that already has an external scheduler
# (a k8s CronJob, an Azure Function on a timer) triggering /runs/live itself
# shouldn't also get an in-process one.
CULPRIT_SCHEDULER_ENABLED=false
# Only seeds the "Scheduled runs" card on /settings the very first time it
# loads (before anything's ever been saved there) - once saved, the DB is
# authoritative and this is no longer consulted. Align it to shortly after
# your maintenance windows close.
CULPRIT_SCHEDULED_CRON=0 4 * * *
CULPRIT_PREFLIGHT_INTERVAL_MINUTES=60

# --- Agent memory (culprit/memory/) ------------------------------------------
# Off by default, and a no-op even when on unless `pip install culprit[memory]`
# is installed (mem0ai + sentence-transformers - not in the base image). A
# confirmed-correct verdict becomes a retrieval exemplar for the next similar
# cluster; a later "wrong" verdict forgets it. Self-hosted only: on-disk
# Chroma (CULPRIT_MEMORY_CHROMA_PATH) + a local embedder, no separate
# service, no data leaves the host. See culprit/memory/__init__.py.
CULPRIT_MEMORY_ENABLED=false
CULPRIT_MEMORY_CHROMA_PATH=culprit_memory_db
CULPRIT_MEMORY_EMBED_MODEL=multi-qa-MiniLM-L6-cos-v1

# --- Phase 2 gate -----------------------------------------------------------
CULPRIT_PROMOTION_THRESHOLD=0.95
CULPRIT_PROMOTION_MIN_SAMPLE=50

# --- Security ---------------------------------------------------------------
CULPRIT_SCRUB_PII=false
# Encrypts the Azure/Datadog secrets saved on the /settings screen at rest.
# Falls back to an insecure, clearly-marked dev-only key if unset - fine for
# the demo, not for anything with a real secret saved.
CULPRIT_ENCRYPTION_KEY=
# Gates every route behind this shared token (a cookie for the browser, set
# once at /login; an Authorization: Bearer header for scripts/curl). Unset =
# no authentication at all, anywhere - fine for the offline demo, a real
# problem the moment this holds real credentials or runs against a real
# subscription. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CULPRIT_API_TOKEN=
